post_install() {
    cat <<'MSG'
==> Creating a virtual keyboard needs write access to /dev/uinput, and the
    abort key needs read access to /dev/input/event*. The udev rule is
    installed; both come with the "input" group:

        sudo usermod -aG input "$USER"

    Log out and back in, then confirm with:

        openautotyper --doctor
MSG
}

post_upgrade() {
    post_install
}
