# Maintainer: huhwhatbruh <https://github.com/huhwhatbruh>

pkgname=openautotyper
pkgver=1.0.0
pkgrel=1
pkgdesc='Type text into the focused window as real keystrokes, at a cadence you control'
arch=('x86_64' 'aarch64')
url='https://github.com/huhwhatbruh/OpenAutoTyper'
license=('MIT')
# The window is egui, which opens its own libraries when it starts rather than
# linking them: wayland and libx11 for the display, libxkbcommon for the
# keyboard, libglvnd for OpenGL. They are real dependencies all the same -- a
# desktop entry that starts a program missing one of them is a button that does
# nothing, so they are depends and not optdepends. The command line needs none
# of them beyond libxkbcommon, which it falls back from if it is absent.
# The icon is installed into the hicolor hierarchy, so the package that owns
# that hierarchy is a dependency too.
depends=('gcc-libs' 'glibc' 'hicolor-icon-theme' 'libglvnd' 'libx11' 'libxkbcommon' 'wayland')
makedepends=('cargo')
# The clipboard is only a fallback for characters no keystroke can reach, and it
# is tried in this order: wl-copy, xclip, xsel.
optdepends=('wl-clipboard: clipboard fallback on Wayland'
            'xclip: clipboard fallback on X11'
            'xsel: clipboard fallback on X11, alternative to xclip'
            'libxtst: the XTEST backend, for X11 sessions without /dev/uinput access'
            'xdg-desktop-portal: the "Open file" dialog in the window')
install="$pkgname.install"
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
# Pinned at release time: the release workflow runs `updpkgsums` against the
# published tarball before building. Pin this before publishing to the AUR.
sha256sums=('SKIP')

# The directory GitHub puts inside the archive is named after the *repository*,
# which is OpenRustTyper -- not after the program, which is OpenAutoTyper. The
# old value matched the URL and not the archive, so `cd` failed on the first
# release build. build-local.sh uses the same prefix; a test keeps them equal.
_srcdir="OpenRustTyper-$pkgver"

prepare() {
  cd "$_srcdir"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$_srcdir"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd "$_srcdir"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  # The device tests need a writable /dev/uinput and read access to
  # /dev/input; both skip themselves in a clean build chroot, which is the
  # normal state of one. What is left still covers the engine end to end.
  cargo test --frozen
}

package() {
  cd "$_srcdir"
  install -Dm755 target/release/openautotyper \
    "$pkgdir/usr/bin/openautotyper"
  install -Dm755 target/release/openautotyper-gui \
    "$pkgdir/usr/bin/openautotyper-gui"

  # A rule shipped by a package belongs in /usr/lib; /etc/udev/rules.d is
  # reserved for the administrator's own overrides.
  install -Dm644 packaging/99-openautotyper-uinput.rules \
    "$pkgdir/usr/lib/udev/rules.d/99-openautotyper-uinput.rules"
  install -Dm644 packaging/openautotyper.desktop \
    "$pkgdir/usr/share/applications/openautotyper.desktop"
  install -Dm644 packaging/openautotyper.svg \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/openautotyper.svg"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
